<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= yield :title %>chi-bus.jp（チーバス・ジェイピー）｜全国対応のバス停情報サービス</title>
    <meta name="description" content="日本のカオスを解消する、日本国民のためのバス停情報サービスです。">
    <meta property="og:title" content="<%= yield :title %>chi-bus.jp（チーバス・ジェイピー）｜全国対応のバス停情報サービス" />
    <meta property="og:site_name" content="chi-bus.jp（チーバス・ジェイピー）｜全国対応のバス停情報サービス" />
    <meta property="og:description" content="日本のカオスを解消する、日本国民のためのバス停情報サービスです。" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="<%= root_url %>" />
    <meta property="og:image" content="<%= image_url("chi-ba-kun-ogp.png") %>" />
    <%= favicon_link_tag %>
    <%= favicon_link_tag 'apple-touch-icon.png', :rel => 'apple-touch-icon', :type => 'image/png' %>
    <%= stylesheet_link_tag    'application', media: 'all', 'data-turbolinks-track' => true %>
    <%= javascript_include_tag 'application', 'data-turbolinks-track' => true %>
    <%= csrf_meta_tags %>
    <% if Rails.env.production? && ENV["GA_TRACKER_ID"].present? %>
      <script async src="https://www.googletagmanager.com/gtag/js?id=<%= ENV["GA_TRACKER_ID"] %>"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '<%= j ENV["GA_TRACKER_ID"] %>');
      </script>
    <% end %>
    <script src="//maps.google.com/maps/api/js?key=<%= ENV["GOOGLE_MAPS_JS_API_KEY"] %>&libraries=geometry"></script>
    <script src="//cdn.rawgit.com/mahnunchik/markerclustererplus/master/dist/markerclusterer.min.js"></script>
    <%= javascript_importmap_tags "main" %>
  </head>
  <body>
    <div class="turbolinks-loading"></div>
    <div class="container-fluid">
      <%= render partial: 'menu' %>
      <%= yield %>
    </div>
  </body>
</html>
